# Workspace pod environment — reference.
#
# You do not normally set these: the dashboard computes them per session in
# dashboard/lib/podTemplate.js. This file documents the contract between the
# two, and lets you run the image standalone to debug a bootstrap failure:
#
#   docker run --rm -it --env-file workspace/.env \
#     -v "$PWD/scratch:/workspace" registry.kieffer.me/berth/workspace:latest
#
# entrypoint.sh supplies safe defaults for the identity variables, so a bare
# `docker run` works — supervisord interpolates %(ENV_*)s and refuses to start
# if any are unset.

# ─── mode ────────────────────────────────────────────────────────────────────
# `workspace` (default): a dashboard-created pod -- clone REPO_URL, launch the
# bootstrap `claude remote`, readiness is that claude. `editor`: the standalone
# VS Code Deployment (k8s/editor.yaml) -- no clone and no bootstrap claude,
# code-server on /workspace (CODE_ENABLE is implied), ttyd and codexapp left
# stopped, readiness is code-server answering.
WORKSPACE_MODE=workspace
# How often the agent probes code-server in editor mode. Not set by anything.
CODE_PROBE_MS=3000

# ─── identity (set by the dashboard) ─────────────────────────────────────────
# Deterministic per repo: also the Pod name, the PVC name, and the /tty/<id>
# route segment.
WORKSPACE_ID=berth-ws-edkief-myrepo-4f1a9c02
# Passed to `claude remote --name`.
CLAUDE_SESSION_NAME=myrepo-main
# ttyd bakes its base path into the JS it serves, so it must match exactly the
# prefix the dashboard proxies it under.
TTY_BASE_PATH=/tty/berth-ws-edkief-myrepo-4f1a9c02
# Persistent Codex login, configuration and thread state on the repo PVC.
CODEX_HOME=/workspace/_home/codex
# pi's ~/.pi/agent (auth, models.json, sessions), on the PVC like CODEX_HOME.
PI_CODING_AGENT_DIR=/workspace/_home/pi
POD_NAME=berth-ws-edkief-myrepo-4f1a9c02

# ─── the checkout ────────────────────────────────────────────────────────────
# Validated by the dashboard before it ever reaches here, and passed to git as
# separate argv elements — never interpolated into a shell string.
REPO_URL=git@github.com:edkief/myrepo.git
# Branch to clone from.
GIT_REF=main
# Branch actually worked on (GIT_REF, or NEW_BRANCH when creating one).
BRANCH=main
# Slug of BRANCH: the directory inside the PVC, /workspace/<BRANCH_SLUG>.
BRANCH_SLUG=main
# Non-empty to create and check out a new branch after cloning.
NEW_BRANCH=
# true = hard-reset an existing checkout to origin, DISCARDING uncommitted
# work. Off unless the user ticks the reset box.
FORCE_RESET=false

# ─── Ralph (only when the dashboard has RALPH_ENABLE=1) ──────────────────────
# Set by the dashboard; absent otherwise. RALPH_ENABLE makes the entrypoint
# install the latest @edkief/ralph at boot (a failure only warns) and the agent
# start, watch and report on the supervised `ralph daemon`. The rest are read
# by `ralph` itself, daemon or hand-run: RALPH_UI serves the web UI beside a
# hand-run loop (the daemon always serves it), on all interfaces so the
# dashboard can reach the pod IP, under the prefix it is proxied at.
# RALPH_UI_ACTIONS=open lets that UI take actions (plan, run, pause) off
# loopback; the ingress auth in front of the dashboard is the boundary.
RALPH_ENABLE=1
RALPH_UI=1
RALPH_UI_HOST=0.0.0.0
RALPH_UI_PORT=4280
RALPH_UI_BASE_PATH=/ralph/berth-ws-edkief-myrepo-4f1a9c02
RALPH_UI_ACTIONS=open
# How often the agent probes the web UI. Not set by the dashboard.
RALPH_PROBE_MS=5000

# ─── VS Code (only when the dashboard has CODE_ENABLE=1) ────────────────────
# Set by the dashboard; absent otherwise. Read by bootstrap/code-server.sh,
# which supervisord runs: unset, it exits at once and nothing listens on 7686.
CODE_ENABLE=1

# ─── runtime ─────────────────────────────────────────────────────────────────
CLAUDE_CODE_VERSION=latest
# OpenCode V2 (@opencode/cli); `latest` updates it on every boot.
OPENCODE_VERSION=latest
# pi (@earendil-works/pi-coding-agent), reinstalled on boot unless it matches.
PI_VERSION=1
# Only when the dashboard has WORKSPACE_TIMEZONE set; unset means UTC.
TZ=UTC
# Bootstrap state (stage markers, checkout path). Container layer, not the PVC.
WORKSPACE_STATE_DIR=/home/ubuntu/.workspace-state
# Health/disk endpoint the readiness probe hits. NetworkPolicy is its boundary.
AGENT_PORT=7682
# Self-heal. Claude is launched by entrypoint.sh into the tmux pane, not by
# supervisord, so nothing else respawns it. The agent retypes the launch
# command up to WORKSPACE_RELAUNCH_MAX times (one per backoff window); after
# that /livez fails and the kubelet restarts the container. 0 disables both,
# leaving a dead session merely not-ready -- which is how a pod once sat 503
# for 8 hours without restarting.
WORKSPACE_SELF_HEAL=1
WORKSPACE_RELAUNCH_MAX=3
WORKSPACE_RELAUNCH_BACKOFF_MS=30000
# How long claude may take to appear after the pane launch before the agent
# reports stage `launch-failed` instead of "starting Claude…" forever. An
# auth failure is detected directly and does not wait this out.
WORKSPACE_LAUNCH_TIMEOUT_MS=180000
# Shared-login sync, run off the readiness probe. Pulls a token another holder
# published, and publishes one this pod's claude was forced to refresh --
# refresh tokens rotate, so an unpublished renewal leaves every other holder,
# including the copy new workspaces bootstrap from, holding a dead one. 0
# disables both directions.
WORKSPACE_TOKEN_SYNC=1
WORKSPACE_TOKEN_SYNC_MS=300000
# For git and gh.
GITHUB_TOKEN=

# ─── shared Claude config (S3 / Garage) ──────────────────────────────────────
# Injected via envFrom: claude-config-s3-rw, or -ro when CONFIG_PUSH_POLICY is
# not `any`. Pulled by entrypoint.sh before Claude starts; skipped entirely if
# S3_ENDPOINT is unset.
CONFIG_PUSH_POLICY=any
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_BUCKET=claude-config
S3_REGION=garage
S3_PROVIDER=Other
S3_FORCE_PATH_STYLE=true
S3_PREFIX=config
# The OAuth token, kept out of the version-counted config bundle. Empty bucket
# means "the same as S3_BUCKET"; the dashboard propagates its own value so a
# split cannot happen. A separate bucket is what lets a workspace publish a
# token refresh while holding read-only credentials for the config -- Garage
# grants key permissions per bucket, not per prefix.
AUTH_S3_BUCKET=
AUTH_S3_KEY=auth/token.json

# ─── overrides (used by k8s/seed-config-job.yaml) ────────────────────────────
# CLAUDE_CONFIG_DIR=/legacy/claude
# CLAUDE_JSON_PATH=/legacy/root/.claude.json
# DASHBOARD_CONFIG_WRITER=true   # exempts the dashboard shell from the policy
